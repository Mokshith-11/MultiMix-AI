# MultiMix AI — Environment Configuration Template
# Copy this file to .env for local environment overrides.
# Note: MultiMix AI runs 100% locally and does not require external cloud API keys.

# Optional: Override the root project path (default: dynamically calculated)
MULTIMIX_PROJECT_ROOT=

# Optional: Windows console encoding configuration
PYTHONIOENCODING=utf-8

# Optional: Streamlit server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
